{
  "schema_version": "covermem.persistent_verl.v1",
  "paths": {
    "base_model": "../models/Qwen3-4B-Instruct-2507",
    "sft_adapter": "../raw43500char_thought_teacher_sft_v4/runs/student/final_adapter",
    "sft_report": "../raw43500char_thought_teacher_sft_v4/runs/student/TRAIN_COMPLETE.json",
    "tokenizer": "../raw43500char_thought_teacher_sft_v4/tokenizers/Qwen3-4B-Instruct-2507",
    "vllm_python": ".venv/bin/python",
    "output": "runs/loo_v1"
  },
  "environment": {
    "bank_budget_chars": 43500,
    "streams": 4,
    "max_action_attempts": 3
  },
  "reward": {
    "complete": 0.7,
    "recall": 0.3,
    "mid_weight": 0.5,
    "end_weight": 0.5,
    "std_correction": 0,
    "epsilon": 1e-08,
    "invalid_advantage_ceiling": -0.5,
    "credit_assignment": {
      "estimator": "pre_action_bank_loo_continuation_gain_v1",
      "fixed_scale": 0.008103060640792133,
      "calibration_file": "calibration.json",
      "calibration_weighting": "valid outputs; response length / all response tokens of session",
      "peer_alignment": "original_turn_first_attempt_exclude_own_trajectory"
    }
  },
  "rollout": {
    "temperature": 1.0,
    "top_p": 1.0,
    "top_k": -1,
    "max_new_tokens": 8192,
    "max_model_len": 32768,
    "seed": 42,
    "request_timeout_seconds": 600,
    "transport_attempts": 3,
    "server_start_timeout_seconds": 900,
    "gpu_memory_utilization": 0.78,
    "max_num_batched_tokens": 4096,
    "enforce_eager": true
  },
  "training": {
    "data_epochs": 1,
    "max_sessions": null,
    "ppo_epochs": 1,
    "effective_batch_sessions": 1,
    "micro_batch_actions": 1,
    "learning_rate": 5e-06,
    "weight_decay": 0.0,
    "adam_betas": [
      0.9,
      0.999
    ],
    "clip_ratio": 0.2,
    "clip_ratio_c": 1000000000.0,
    "kl_coef": 0.02,
    "kl_type": "low_var_kl",
    "grad_clip": 1.0,
    "gradient_checkpointing": true,
    "attention_implementation": "sdpa",
    "dtype": "bfloat16",
    "loss_aggregation": "global_response_token_mean",
    "skip_zero_signal_sessions": true,
    "seed": 42
  },
  "validation": {
    "max_preupdate_mean_abs_logprob_gap": 0.15,
    "max_preupdate_logprob_gap": 2.0,
    "require_slurm_for_gpu": true
  }
}
